{
  "name": "@pop-choice/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze-movies": "tsx scripts/analyze-movies.ts",
    "build": "next build",
    "build-storybook": "storybook build",
    "calibrate-similarity": "tsx --env-file=.env scripts/calibrate-similarity.ts",
    "dev": "next dev",
    "enqueue:catalog-maintenance": "NODE_OPTIONS=\"--require ./scripts/coolify-runtime-env.cjs\" tsx --env-file=.env scripts/enqueue-catalog-maintenance.ts",
    "eval:recommendations": "tsx scripts/evaluate-recommendations.ts",
    "fix": "npm run lint:fix && npm run format:write",
    "lint": "eslint .",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate:db": "NODE_OPTIONS=\"--require ./scripts/coolify-runtime-env.cjs\" node scripts/migrate-db.js",
    "start": "NODE_OPTIONS=\"--require ./scripts/coolify-runtime-env.cjs\" next start",
    "start:storybook": "serve -s storybook-static -l tcp://0.0.0.0:${PORT:-3000}",
    "start:with-migrations": "npm run migrate:db && npm run start",
    "start:workers": "NODE_OPTIONS=\"--require ./scripts/coolify-runtime-env.cjs\" tsx src/lib/workers/startWorkers.ts",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:e2e": "playwright test --config playwright.e2e.config.ts",
    "test:server": "vitest run --project=server",
    "pretest:storybook": "npx playwright install && npx playwright install-deps",
    "test:storybook": "vitest --project=storybook run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^1.1.49",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/instrumentation": "^0.219.0",
    "@opentelemetry/instrumentation-http": "^0.219.0",
    "@opentelemetry/instrumentation-ioredis": "^0.67.0",
    "@opentelemetry/instrumentation-pg": "^0.71.0",
    "@opentelemetry/instrumentation-undici": "^0.29.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@pop-choice/shared": "*",
    "@tanstack/react-query": "^5.101.0",
    "@xstate/react": "^6.1.0",
    "bullmq": "^5.79.1",
    "canvas-confetti": "^1.9.4",
    "ioredis": "5.11.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "nanoid": "^5.1.15",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "openai": "^6.44.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "react": "^19.2.7",
    "react-canvas-confetti": "^2.0.7",
    "react-dom": "^19.2.7",
    "redis": "^5.12.1",
    "serve": "^14.2.6",
    "tsx": "^4.22.4",
    "xstate": "^5.32.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/nextjs-vite": "^10.4.6",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@types/express": "^5.0.6",
    "@types/node": "25.9.3",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.4",
    "@xstate/graph": "^3.0.4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-storybook": "^10.4.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "msw": "^2.14.6",
    "msw-storybook-addon": "^2.0.7",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.61.0",
    "storybook": "^10.4.6",
    "tailwindcss": "^4",
    "typescript": "6.0.3",
    "vitest": "^4.1.9",
    "webpack": "^5.107.2"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
