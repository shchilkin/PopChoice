{
  "name": "@pop-choice/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./button": {
      "types": "./src/button.tsx",
      "default": "./src/button.tsx"
    },
    "./badge": {
      "types": "./src/badge.tsx",
      "default": "./src/badge.tsx"
    },
    "./breadcrumb": {
      "types": "./src/breadcrumb.tsx",
      "default": "./src/breadcrumb.tsx"
    },
    "./dialog": {
      "types": "./src/dialog.tsx",
      "default": "./src/dialog.tsx"
    },
    "./tabs": {
      "types": "./src/tabs.tsx",
      "default": "./src/tabs.tsx"
    },
    "./table": {
      "types": "./src/table.tsx",
      "default": "./src/table.tsx"
