# ──────────────────────────────────────────────
# PopChoice – Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Database credentials are generated automatically
# by `npm run setup:local-db`.

# ── Required ──────────────────────────────────
OPENAI_API_KEY=
DATABASE_URL=               # auto-generated by setup:local-db

# ── Optional ──────────────────────────────────
# Enables server-side OpenAI usage/cost telemetry in backoffice.
OPENAI_ADMIN_API_KEY=
TMDB_API_KEY=               # enables live poster images & "get more picks"
NEXT_PUBLIC_TMDB_API_KEY=   # client-side movie poster enrichment
REDIS_URL=                  # required for BullMQ workers (recommendations, more-picks, movie-seed) & rate limiting
NEXT_PUBLIC_BASE_URL=       # public URL for CSRF validation (required behind a reverse proxy)
LOG_LEVEL=info              # debug | info | warn | error
RESEND_API_KEY=             # enables production password reset emails
EMAIL_FROM=PopChoice <noreply@mail.shchilkin.dev>
EMAIL_REPLY_TO=support@mail.shchilkin.dev

# ── Operator Surface Authentication ──────────
# Required before exposing Bull Board or future backoffice outside localhost.
# OPERATOR_AUTH_USERNAME=
# OPERATOR_AUTH_PASSWORD=
# OPERATOR_AUTH_REALM=PopChoice Operators
# OPERATOR_AUTH_REQUIRED=   # optional; set 1 to fail startup when credentials are missing

# ── API Key Authentication (production) ──────
# AUTH_SESSION_SECRET=     # stable login-session signing secret for production
# API_KEY_HMAC_SECRET=      # HMAC secret for API key verification
# VALID_API_KEYS=           # comma-separated scrypt digests

# ── Auto-generated by setup:local-db ─────────
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
