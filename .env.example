# OpenAI — required for embeddings and recommendations
OPENAI_API_KEY=your_openai_api_key

# TMDB — required for movie data and poster images
TMDB_API_KEY=your_tmdb_api_key
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key

# PostgreSQL — set automatically by `npm run setup:local-db`, or supply your own
DATABASE_URL=postgresql://user:password@localhost:5432/popchoice
