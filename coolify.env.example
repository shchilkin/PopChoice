# Coolify / VPS production environment template
# Copy into Coolify service variables or a secure env file.

# Core runtime
NODE_ENV=production
WEB_PORT=3000
BULL_BOARD_PORT=3001
LOG_LEVEL=info

# Self-hosted PostgreSQL
POSTGRES_USER=popchoice
POSTGRES_PASSWORD=change-me
POSTGRES_DB=popchoice
DATABASE_URL=postgresql://popchoice:<POSTGRES_PASSWORD>@postgres:5432/popchoice

# Self-hosted Redis
REDIS_URL=redis://redis:6379

# Required external APIs
OPENAI_API_KEY=
TMDB_API_KEY=
NEXT_PUBLIC_TMDB_API_KEY=

# Web security
NEXT_PUBLIC_BASE_URL=https://popchoice.example.com
API_KEY_HMAC_SECRET=
AUTH_SESSION_SECRET=
VALID_API_KEYS=

# Optional movie-discovery tuning
SYNC_SCHEDULE=0 0 * * 0
TMDB_SOURCES=now_playing,upcoming,top_rated,popular
MAX_PAGES_PER_SOURCE=3
MIN_VOTE_COUNT=500
MIN_VOTE_AVERAGE=6.5
MAX_MOVIES_PER_RUN=50
TMDB_LANGUAGE=en-US
DISCOVERY_DRY_RUN=false

# Optional admin-job overrides
MOVIES_FILE_PATH=
MOVIE_SEED_DRY_RUN=false
