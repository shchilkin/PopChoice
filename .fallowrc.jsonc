{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/coverage/**",
    "**/e2e/**",
    "**/*.stories.*",
    "**/playwright-report/**",
    "**/test-results/**",
    ".turbo/**",
  ],
  "entry": ["apps/web/scripts/coolify-runtime-env.cjs", "docs/index.mdx"],
  "ignoreDependencies": [
    "@storybook/nextjs-vite",
    "@opentelemetry/instrumentation",
    "@opentelemetry/semantic-conventions",
    "@pop-choice/shared",
    "pino-pretty",
  ],
  "ignoreUnresolvedImports": ["collections/server"],
  "duplicates": {
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "ignoreImports": true,
    "ignore": ["**/*.stories.*", "**/*.test.*", "**/*.spec.*", "**/e2e/**"],
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "ignore": [
      "**/*.stories.*",
      "**/*.test.*",
      "**/*.spec.*",
      "**/e2e/**",
      "apps/web/public/mockServiceWorker.js",
    ],
  },
  "audit": {
    "gate": "new-only",
  },
}
