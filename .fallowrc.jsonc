{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/coverage/**",
    "**/e2e/**",
    "**/*.stories.*",
    "**/playwright-report/**",
    "**/test-results/**",
    ".turbo/**",
    // Preserve unused components from the original Figma Make export without
    // treating them as maintained application code.
    "apps/figma-make/src/app/components/figma/**",
    "apps/figma-make/src/app/components/ui/**",
    "apps/figma-make/src/guidelines/**",
  ],
  "entry": [
    "apps/figma-make/src/main.tsx",
    "apps/web/scripts/coolify-runtime-env.cjs",
    "docs/index.mdx",
  ],
  "ignoreDependencies": [
    "@storybook/nextjs-vite",
    "@opentelemetry/instrumentation",
    "@opentelemetry/semantic-conventions",
    "@pop-choice/shared",
    "pino-pretty",
  ],
  "ignoreUnresolvedImports": ["/src/main.tsx", "collections/server"],
  "duplicates": {
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "ignoreImports": true,
    "ignore": [
      "**/*.stories.*",
      "**/*.test.*",
      "**/*.spec.*",
      "**/e2e/**",
      "apps/figma-make/src/**",
    ],
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "ignore": [
      "**/*.stories.*",
      "**/*.test.*",
      "**/*.spec.*",
      "**/e2e/**",
      "apps/figma-make/src/**",
      "apps/web/public/mockServiceWorker.js",
    ],
  },
  "audit": {
    "gate": "new-only",
  },
}
